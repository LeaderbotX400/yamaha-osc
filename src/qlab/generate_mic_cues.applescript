--
-- Adds ONE top-level group "MIC CUES" at the end of the front QLab workspace holding 22 flat Network cues,
-- "MIC <n> - <SONG> (A<slot>)", each sending /scene/recall a <slot>. Existing cues are not touched.
-- BEFORE RUNNING: Edit mode (not Show mode), a saved copy of the show, and afterwards set the new cues' patch to TF3
-- (a script cannot set a cue's patch). Run on the booth Mac:  osascript generate_mic_cues.applescript

tell application "QLab"
  tell front workspace
    make type "Group"
    set micTop to last item of (selected as list)
    set q name of micTop to "MIC CUES"
    set madeCount to 0
    set cueRows to {¬
    {1, "MIC 1 - CHRISTMAS CHEER (A76)", "/scene/recall a 76", "Mics on 2-24 | leads 2-5,14 | backing 6-13,15-24 | 3 Poppy/4 Francis/5 Holly never sing over anyone: chorus-level mic'ing works. 14 Hattie carries; if raised, bring back to chorus level after her solo. Brassheart sings over the chorus only at the end."}, ¬
    {2, "MIC 2 - MOODY WEISENBROOD (A77)", "/scene/recall a 77", "Mics on 2-24 | leads 6-10 | backing 2-5,11-24 | No solo sings over the chorus, but all chorus mics down a touch (a lot of mics at once)."}, ¬
    {3, "MIC 3 - CHRISTMAS CHEER REPRISE (A78)", "/scene/recall a 78", "Mics on 2 | leads 2 | backing - | Solo: Brassheart."}, ¬
    {4, "MIC 4 - CAROL ONE/TWO/THREE (A79)", "/scene/recall a 79", "Mics on 19-21 | leads 19-21 | backing - | Solos: 19 Patty (Alto), 20 Brenda (2 Sop), 21 Veronica (1 Sop)."}, ¬
    {5, "MIC 5 - THE STORY (A80)", "/scene/recall a 80", "Mics on 1,22,23 | leads 1,22,23 | backing - | 1 Traci lead; 22 Fred and 23 Elodie back up."}, ¬
    {6, "MIC 6 - LAST YEAR ON THE TREE - PART A and B (A81)", "/scene/recall a 81", "Mics on 1-5,24 | leads 1-5,24 | backing - | Solos 2-5; spoken lines 1 Traci, 24 Agnes."}, ¬
    {7, "MIC 7 - THE ABDUCTION (A82)", "/scene/recall a 82", "Mics on 1-18,22,23 | leads 1-5 | backing 6-18,22,23 | Brassheart (2) has a big solo at the end and must be louder than the chorus - the only moment the chorus sings with a soloist. 2-5 join the chorus when not soloing. Female chorus 3,5,6-10,12,13,14,16,23; male 2,4,11,15,17,18,22."}, ¬
    {8, "MIC 8 - ANGELS (A83)", "/scene/recall a 83", "Mics on 1,19-21 | leads 1,19-21 | backing - | Solos 19 Patty (lead), 20 Brenda (alto), 21 Veronica (sop); speaking 1 Traci."}, ¬
    {9, "MIC 9 - IT'S BEEN A BAD YEAR (A84)", "/scene/recall a 84", "Mics on 2-18,22-24 | leads 24 | backing 2-18,22,23 | Solo 24 Agnes; chorus 2-18, 22, 23."}, ¬
    {10, "MIC 10 - CRISPIN PART A (A85)", "/scene/recall a 85", "Mics on 2,4,5 | leads 2,4,5 | backing - | Solo 2 Brassheart; speaking 4 Francis, 5 Holly."}, ¬
    {11, "MIC 11 - THE DEAL (A86)", "/scene/recall a 86", "Mics on 1-10 | leads 1,2,6-10 | backing 3-5 | Solos 2, 6 Heart Attack (main lead), 7-10; chorus 3-5; speaking 1, 2, 6."}, ¬
    {12, "MIC 12 - IMPERFECT FRED (A87)", "/scene/recall a 87", "Mics on 22 | leads 22 | backing - | Solo 22 Fred."}, ¬
    {13, "MIC 13 - IMPERFECT COMMITTEE (A88)", "/scene/recall a 88", "Mics on 1-13,22 | leads 11-13,22 | backing 1-10 | Solos 22 Fred, 11 Mr Darcy, 12 Trixie, 13 Sugarplum; chorus 1-10."}, ¬
    {14, "MIC 14 - CRISPIN PART B (A89)", "/scene/recall a 89", "Mics on 2,5 | leads 2,5 | backing - | Solo 2 Brassheart; speaking 2, 5 Holly."}, ¬
    {15, "MIC 15 - MOODY WEISENBROOD REPRISE (A90)", "/scene/recall a 90", "Mics on 1,2,15 | leads 1,2,15 | backing - | Solos 1 Traci, 2 Brassheart, 15 Crispin."}, ¬
    {16, "MIC 16 - STAR TOPPER (A91)", "/scene/recall a 91", "Mics on 1,3-13,15,16 | leads 3,15,16 | backing 1,4-13 | Solos 15 Barny Bow, 16 Barby Bow, 3 Poppy; chorus 1,3-13; speaking 11, 1, 3."}, ¬
    {17, "MIC 17 - CHRISTMAS DON'T HAVE TIME (A92)", "/scene/recall a 92", "Mics on 2,3 | leads 2,3 | backing - | Solos 2 Brassheart, 3 Poppy."}, ¬
    {18, "MIC 18 - THE CLIMB (A93)", "/scene/recall a 93", "Mics on 1-13,15,16,18-21 | leads 1,2 | backing 3-13,15,16,18-21 | Brassheart and Traci sing in unison over the chorus at the end and must be heard."}, ¬
    {19, "MIC 19 - BETTER DAYS (A94)", "/scene/recall a 94", "Mics on 11-13,23 | leads 11-13,23 | backing - | Solos 23 Elodie (main lead), 11 Mr Darcy, 12 Trixie, 13 Sugarplum."}, ¬
    {20, "MIC 20 - I AM THE STAR (A95)", "/scene/recall a 95", "Mics on 1-13,15,16,18,19,21 | leads 18 | backing 1-13,15,16,19,21 | Solo 18 Star Topper. Sop/alto split at the end may need adjusting: sops 13, 9, 6; altos 12, 15."}, ¬
    {21, "MIC 21 - WHY CAN'T I DO THIS? (A96)", "/scene/recall a 96", "Mics on 1-16 | leads 1-5 | backing 6-16 | Brassheart (2) is main soloist throughout, with a solo over the chorus; the others have one line each. Speaking 1, 2, 3, 4, 14 Hattie."}, ¬
    {22, "MIC 22 - IT'S A NEW DAY (A97)", "/scene/recall a 97", "Mics on 1-24 | leads 1,2 | backing 3-24 | Traci and Brassheart start as soloists; as the chorus enters they sing in groups, all at chorus level. Groups: 1-5, 6-10, 11-13, 22-24, others 14-21."}}
    repeat with row in cueRows
      set nm to item 2 of row
      set have to false
      repeat with k in (cues of micTop)
        if (q name of k) is nm then set have to true
      end repeat
      if not have then
        make type "Network"
        set c to last item of (selected as list)
        set q name of c to nm
        set custom message of c to (item 3 of row)
        try
          set notes of c to (item 4 of row)
        end try
        move c to end of micTop
        set madeCount to madeCount + 1
      end if
    end repeat
    save
    return "created " & madeCount & " flat MIC cues inside MIC CUES; saved"
  end tell
end tell
